# Copy to .env and fill in your Tindie credentials
TINDIE_USERNAME=your_tindie_username
TINDIE_PASSWORD=your_tindie_password
TINDIE_API_KEY=your_api_key_here
# Optional: scripts can discover this from an existing product ID
TINDIE_STORE_ID=your_numeric_store_id

# Google Ads MCP (never commit real values or credential JSON)
GOOGLE_PROJECT_ID=your_google_cloud_project_id
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\application_default_credentials.json
# Optional when access is through a Google Ads manager account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_manager_customer_id

# Google Ads stock gates (account-specific IDs belong only in .env)
GOOGLE_ADS_CUSTOMER_ID=your_customer_id
GOOGLE_ADS_TINDIE_CS5490_AD_GROUP_ID=your_ad_group_id
GOOGLE_ADS_TINDIE_GAMEPAD_AD_GROUP_ID=your_ad_group_id
GOOGLE_ADS_TINDIE_V9381_AD_GROUP_ID=your_ad_group_id
GOOGLE_ADS_ELECROW_MCP39F521_AD_GROUP_ID=your_ad_group_id
GOOGLE_ADS_ELECROW_V9360_AD_GROUP_ID=your_ad_group_id
